  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uAC10\uC9C0 \uAE30\uC900\uAC12: \uB0AE\uC744\uC218\uB85D \uBBFC\uAC10
    (\uB178\uC774\uC988\uB3C4 \uC7A1\uD798), \uB192\uC744\uC218\uB85D \uB454\uAC10\n 
    \u2192 \uC544\uBB34\uB3C4 \uC5C6\uC744 \uB54C \uADF8\uB9AC\uB4DC\uAC00 \uAEBC\uC9C4
    \uCC44 \uC720\uC9C0\uB418\uB294 \uAC00\uC7A5 \uB0AE\uC740 \uAC12\n\uC88C\uC6B0
    \uBC18\uC804: \uCF1C\uBA74 \uAC70\uC6B8\uCC98\uB7FC \uBCF4\uC784\n\uC2E4\uB4DC
    \uBC1C\uB3D9 \uAC10\uB3C4: \uB192\uC77C\uC218\uB85D \uD06C\uAC8C \uD754\uB4E4\uC5B4\uC57C
    \uBC1C\uB3D9\n\uAC01\uC131 \uC694\uAD6C \uC2DC\uAC04: \uCD08 \uB2E8\uC704. \uAC8C\uC784
    \uAC12\uC740 \uC989\uC2DC \uC801\uC6A9, [\uC124\uC815 \uC800\uC7A5] \uC2DC \uC720\uC9C0\n*
    \uAC10\uC9C0 \uAE30\uC900\uAC12\xB7\uC88C\uC6B0 \uBC18\uC804\uC740 \uC989\uC2DC
    \uC801\uC6A9, [\uC124\uC815 \uC800\uC7A5] \uC2DC \uB2E4\uC74C \uC2E4\uD589\uC5D0\uB3C4
    \uC720\uC9C0\n* \uCE74\uBA54\uB77C\xB7\uADF8\uB9AC\uB4DC\xB7UDP \uC124\uC815\uC740
    config.json \uC218\uC815 \uD6C4 \uC7AC\uC2E4\uD589"
